# If your DB password contains an "@" (or other reserved URL characters),
# percent-encode it (e.g. "@" -> "%40") or the connection string won't parse.
DATABASE_URL=postgresql://postgres:temp1234@localhost:5432/wa_messanger
JWT_SECRET=generate_a_long_random_string
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# S3-compatible object storage (e.g. a Supabase Storage bucket's S3 endpoint)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
